# ---------------------------------------------------------------------------
# A&A Motors CRM — environment variables
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (used by the postgres container and the backend) --------------
POSTGRES_DB=aamotors
POSTGRES_USER=aamotors
POSTGRES_PASSWORD=change-me-postgres
DB_URL=jdbc:postgresql://postgres:5432/aamotors
DB_USERNAME=aamotors
DB_PASSWORD=change-me-postgres

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_DEFAULT_USER=aamotors
RABBITMQ_DEFAULT_PASS=change-me-rabbit
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=aamotors
RABBITMQ_PASSWORD=change-me-rabbit

# --- Administrator bootstrap (first start only; change the password in the UI)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-at-least-10-chars

# --- Demo data (local development only) -------------------------------------
SEED_DEMO_DATA=true                 # seeds 3 customers / 4 vehicles / 7 visits when the customers table is empty

# --- Sessions / security ---------------------------------------------------
SESSION_COOKIE_SECURE=false        # true behind HTTPS
SESSION_TIMEOUT=12h
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_DURATION=15m

# --- Media uploads ---------------------------------------------------------
MEDIA_ROOT=/app/uploads

# --- Ports exposed on the host ---------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432                  # host port for PostgreSQL (native dev loop)
RABBITMQ_HOST_PORT=5672             # host port for AMQP (native dev loop)
RABBITMQ_MANAGEMENT_PORT=15672

# --- SMS (AWS End User Messaging SMS) --------------------------------------
# MOCK = simulate sending (default, safe). AWS = real delivery (needs verified sender for Armenia).
SMS_PROVIDER=MOCK
SMS_ENABLED=false                   # with MOCK the mock still "sends"; with AWS nothing is sent while false
SMS_MAX_ATTEMPTS=5
SMS_BASE_BACKOFF=10s
SMS_MAX_BACKOFF=10m
SMS_RATE_PER_SECOND=5
AWS_SMS_SNS_TOPIC_ARN=              # SNS topic of the SMS event destination (delivery events webhook validation)
AWS_REGION=eu-central-1
AWS_SMS_ORIGINATION_IDENTITY=        # sender ID, phone number ARN or pool ARN registered for AM
AWS_SMS_CONFIGURATION_SET=           # configuration set with event destinations for delivery tracking
# AWS credentials come from the default provider chain (env vars, profile, IAM role). Do not put them here
# unless running locally: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

# --- Campaigns ------------------------------------------------------------
CAMPAIGN_TICK=30s                   # scheduler interval
CAMPAIGN_BATCH_SIZE=50              # recipients dispatched per tick
COST_WHATSAPP_AMD=0                 # per-message cost estimates (AMD); 0 = unknown
COST_VIBER_BUSINESS_AMD=0
COST_TELEGRAM_AMD=0
COST_VIBER_BOT_AMD=0

# --- Public URL (webhooks + absolute media links for providers) --------------
APP_PUBLIC_BASE_URL=                # e.g. https://crm.example.am (HTTPS required by Meta/Telegram/Viber)

# --- WhatsApp Business Cloud API (Meta) ------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_MARKETING_TEMPLATE=        # approved MARKETING template name with body {{1}}
WHATSAPP_MARKETING_MEDIA_TEMPLATE=  # approved MARKETING template with image header + body {{1}}
WHATSAPP_TEMPLATE_LANGUAGE=hy

# --- Viber Business Messages (approved partner — not yet available) ---------
VIBER_BUSINESS_ENABLED=false
VIBER_BUSINESS_PARTNER_API_KEY=

# --- Viber Bot API ---------------------------------------------------------
VIBER_BOT_ENABLED=false
VIBER_BOT_AUTH_TOKEN=
VIBER_BOT_NAME=A&A Motors
VIBER_BOT_URI=                      # bot URI from the Viber admin panel (deep links)

# --- Telegram Bot API ------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=              # e.g. AAMotorsBot (used for deep links / QR codes)
